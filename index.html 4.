<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#190817">

<title>یک سورپرایز عاشقانه ❤️</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    overflow: hidden;
    font-family: 'Vazirmatn', sans-serif;
    background:
        radial-gradient(circle at 50% 40%, #50152f, #210d25 55%, #100814);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.container {
    width: 90%;
    max-width: 500px;
    position: relative;
    z-index: 2;
}

.badge {
    display: inline-block;
    padding: 8px 20px;
    border: 1px solid #ff668b55;
    border-radius: 50px;
    background: #ff477e12;
    color: #ffafc4;
    font-size: 13px;
    margin-bottom: 25px;
}

h1 {
    font-size: clamp(25px, 6vw, 36px);
    font-weight: 800;
    color: #fff;
    margin-bottom: 15px;
    text-shadow: 0 0 25px #ff477e55;
}

.subtitle {
    font-size: 15px;
    color: #e7bacb;
    line-height: 2;
    margin-bottom: 35px;
}

button {
    font-family: inherit;
    border: none;
    padding: 16px 38px;
    border-radius: 50px;
    color: white;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    background: linear-gradient(135deg, #ff79a2, #ec174f);
    box-shadow: 0 0 25px #ff477e77;
    transition: .35s;
}

button:active {
    transform: scale(.94);
}

button:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 45px #ff477e;
}

/* Heart */

.heart-wrapper {
    width: 180px;
    height: 180px;
    position: relative;
    margin: 45px auto 30px;
    display: none;
    animation: appear 1s ease forwards;
}

.heart {
    position: absolute;
    width: 100px;
    height: 100px;
    top: 40px;
    left: 40px;
    background: linear-gradient(135deg, #ff8cae, #ff174f);
    transform: rotate(-45deg);
    filter: drop-shadow(0 0 25px #ff174f);
    animation: beat 1.1s infinite;
}

.heart::before,
.heart::after {
    content: "";
    position: absolute;
    width: 100px;
    height: 100px;
    background: inherit;
    border-radius: 50%;
}

.heart::before {
    top: -50px;
    left: 0;
}

.heart::after {
    top: 0;
    left: 50px;
}

@keyframes beat {
    0%, 100% {
        transform: rotate(-45deg) scale(1);
    }
    50% {
        transform: rotate(-45deg) scale(1.17);
    }
}

@keyframes appear {
    from {
        opacity: 0;
        transform: scale(.1) rotate(-180deg);
    }
    to {
        opacity: 1;
        transform: scale(1) rotate(0);
    }
}

/* Message */

.message {
    color: #ffc1d3;
    font-size: 19px;
    font-weight: 700;
    line-height: 2;
    min-height: 60px;
    opacity: 0;
    transform: translateY(20px);
    transition: 1s;
    text-shadow: 0 0 20px #ff477e;
}

.message.show {
    opacity: 1;
    transform: translateY(0);
}

/* Floating particles */

.particle {
    position: fixed;
    bottom: -40px;
    pointer-events: none;
    z-index: 1;
    animation: floatUp linear forwards;
}

@keyframes floatUp {
    0% {
        transform: translateY(0) rotate(0) scale(.5);
        opacity: 0;
    }
    15% {
        opacity: 1;
    }
    100% {
        transform: translateY(-110vh) rotate(360deg) scale(1.4);
        opacity: 0;
    }
}

/* Footer */

footer {
    position: fixed;
    bottom: 20px;
    width: 100%;
    text-align: center;
    font-size: 12px;
    color: #d5a8ba;
    opacity: .8;
    z-index: 2;
}

footer span {
    color: #ff789c;
}

/* Mobile */

@media(max-width: 480px) {
    .container {
        width: 88%;
    }

    h1 {
        font-size: 27px;
    }

    .subtitle {
        font-size: 14px;
    }

    button {
        font-size: 16px;
        padding: 15px 30px;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="badge">یک سورپرایز کوچک برای تو ❤️</div>

    <h1>یه چیزی برات دارم...</h1>

    <p class="subtitle" id="subtitle">
        بعضی چیزها رو نمیشه با کلمات گفت؛
        <br>
        باید با قلب احساسشون کرد!
    </p>

    <button id="openBtn" onclick="openHeart()">
        قلبم رو باز کن ❤️
    </button>

    <div class="heart-wrapper" id="heartWrapper">
        <div class="heart"></div>
    </div>

    <div class="message" id="message"></div>

</div>

<footer>
    ساخته شده با <span>♥</span> توسط بچه‌های رومیلند
</footer>

<script>

let opened = false;
let particleTimer;

function openHeart() {

    const wrapper = document.getElementById("heartWrapper");
    const message = document.getElementById("message");
    const button = document.getElementById("openBtn");
    const subtitle = document.getElementById("subtitle");

    if (!opened) {

        wrapper.style.display = "block";

        wrapper.style.animation = "none";
        void wrapper.offsetWidth;
        wrapper.style.animation = "appear 1s ease forwards";

        subtitle.style.display = "none";

        button.innerHTML = "بستن سورپرایز 💗";

        message.innerHTML = "تو یکی از قشنگ‌ترین اتفاق‌های دنیایی! ❤️";

        setTimeout(() => {
            message.classList.add("show");
        }, 700);

        createParticles();

        opened = true;

    } else {

        wrapper.style.display = "none";
        message.classList.remove("show");
        subtitle.style.display = "block";

        button.innerHTML = "قلبم رو باز کن ❤️";

        opened = false;
    }
}

function createParticles() {

    for (let i = 0; i < 40; i++) {

        setTimeout(() => {

            const particle = document.createElement("div");

            particle.className = "particle";

            const hearts = ["❤️", "💕", "💗", "💖", "💘"];

            particle.innerHTML =
                hearts[Math.floor(Math.random() * hearts.length)];

            particle.style.left = Math.random() * 100 + "vw";
            particle.style.fontSize = (15 + Math.random() * 25) + "px";
            particle.style.animationDuration = (3 + Math.random() * 4) + "s";

            document.body.appendChild(particle);

            setTimeout(() => particle.remove(), 7500);

        }, i * 100);
    }
}

// Background floating hearts

setInterval(() => {

    const particle = document.createElement("div");

    particle.className = "particle";
    particle.innerHTML = "♥";

    particle.style.left = Math.random() * 100 + "vw";
    particle.style.fontSize = "15px";
    particle.style.animationDuration = "7s";

    document.body.appendChild(particle);

    setTimeout(() => particle.remove(), 7000);

}, 1000);

</script>

</body>
</html>
